rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Daily reports
    match /daily_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);
    }

    // Attendance records (Staff)
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);
    }

    // Student attendance (Individual logs)
    match /student_attendance/{logId} {
      allow read: if isAuthenticated() && (resource.data.markedBy == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.markedBy == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.markedBy == request.auth.uid);
    }

    // Homework assignments
    match /homework_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid);
    }

    // Students list (ReadOnly for teachers)
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin via separate panel
    }

    // Announcements (ReadOnly for teachers)
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin
    }

    // Institute Config
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
